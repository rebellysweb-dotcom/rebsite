{
  "name": "rebellys",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:build": "npx @opennextjs/cloudflare build",
    "cf:dev": "npx wrangler dev --compatibility-date=2024-09-23",
    "cf:deploy": "npx wrangler deploy",
    "cf:d1:create": "npx wrangler d1 create rebellys-db",
    "cf:d1:migrate:local": "npx wrangler d1 migrations apply rebellys-db --local",
    "cf:d1:migrate": "npx wrangler d1 migrations apply rebellys-db --remote",
    "cf:d1:seed:gen": "node scripts/gen-seed.mjs",
    "cf:d1:seed:local": "npx wrangler d1 execute rebellys-db --local --file=./cloudflare/seed.d1.sql",
    "cf:d1:seed": "npx wrangler d1 execute rebellys-db --remote --file=./cloudflare/seed.d1.sql",
    "cf:admin:create": "node scripts/create-admin.mjs",
    "cf:r2:create": "npx wrangler r2 bucket create rebellys-images"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "next": "^16.4.6",
    "posthog-js": "^1.160.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@opennextjs/cloudflare": "^1.4.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
